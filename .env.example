OLLAMA_API_KEY=

# Docker Compose (FC38) reads this file for ${VAR} substitution — values below
# are the compose defaults, documented here; uncomment to override:
#
#   # The api container reaches the HOST machine's Ollama:
#   ADVISOR_LLM_BASE_URL=http://host.docker.internal:11434
#
#   # Or run the container fully offline with the deterministic stub:
#   ADVISOR_LLM_PROVIDER=stub
#
#   # Browser-side URL the built frontend calls (must be reachable from your host):
#   VITE_API_BASE_URL=http://localhost:8000